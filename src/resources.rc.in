// Generated from resources.rc.in by CMake. The .ico lives in the source tree.
#include <windows.h>
#include "@CMAKE_CURRENT_SOURCE_DIR@/src/resource.h"

// The icon id (101) matches IDI_APPICON in resource.h.
101 ICON "@CMAKE_CURRENT_SOURCE_DIR@/assets/HdrScreenshotSyncer.ico"

// App-overrides dialog. Control captions are filled at runtime from the strings
// table, so only IDCANCEL (the close button) carries placeholder text here.
IDD_OVERRIDES DIALOGEX 0, 0, 268, 228
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "App overrides"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_OVR_INTRO, 8, 7, 252, 9
    LISTBOX         IDC_OVR_LIST, 8, 20, 252, 92,
                    LBS_NOINTEGRALHEIGHT | LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_OVR_PROCESS, 8, 120, 40, 9
    EDITTEXT        IDC_OVR_EXE, 50, 118, 146, 12, ES_AUTOHSCROLL
    PUSHBUTTON      "", IDC_OVR_BROWSE, 202, 117, 58, 14
    PUSHBUTTON      "", IDC_OVR_USELAST, 50, 134, 110, 14
    AUTORADIOBUTTON "", IDC_OVR_HDR, 50, 154, 100, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "", IDC_OVR_SDR, 154, 154, 100, 10
    PUSHBUTTON      "", IDC_OVR_ADD, 50, 172, 84, 14
    PUSHBUTTON      "", IDC_OVR_REMOVE, 140, 172, 84, 14
    LTEXT           "", IDC_OVR_TIP, 8, 192, 252, 18
    DEFPUSHBUTTON   "Close", IDCANCEL, 210, 210, 50, 14
END

1 VERSIONINFO
FILEVERSION @APP_VERSION_MAJOR@,@APP_VERSION_MINOR@,@APP_VERSION_PATCH@,0
PRODUCTVERSION @APP_VERSION_MAJOR@,@APP_VERSION_MINOR@,@APP_VERSION_PATCH@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "mangokingTW"
            VALUE "FileDescription", "HDR Screenshot Syncer"
            VALUE "FileVersion", "@APP_VERSION@.0"
            VALUE "InternalName", "HdrScreenshotSyncer"
            VALUE "OriginalFilename", "HdrScreenshotSyncer.exe"
            VALUE "ProductName", "HDR Screenshot Syncer"
            VALUE "ProductVersion", "@APP_VERSION@.0"
            VALUE "LegalCopyright", "Copyright (c) mangokingTW"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
